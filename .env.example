APP_ENV=local
POSTGRES_PASSWORD=support_pilot_local
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
EMBEDDING_MODEL=
LLM_TIMEOUT_SECONDS=60
EVIDENCE_SCORE_THRESHOLD=0.10
ANSWER_TOP_K=5
BACKEND_BASE_URL=http://127.0.0.1:8080
BACKEND_TIMEOUT_SECONDS=5
BACKEND_TOOL_TRANSPORT=mcp
AGENT_MAX_STEPS=12
AGENT_DATABASE_PATH=./data/agent-conversations.db
KNOWLEDGE_BASE_PATH=./data/knowledge-bases
RETRIEVAL_MODE=local
# external 模式下使用；本地无鉴权 Elasticsearch 可将 API key 留空
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=knowledge_studio_chunks
ELASTICSEARCH_API_KEY=
# Milvus Standalone 的 REST 地址与默认本地凭据
MILVUS_URL=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge_studio_chunks
MILVUS_TOKEN=root:Milvus
